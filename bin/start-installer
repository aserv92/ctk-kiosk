#!/usr/bin/env bash

set -euo pipefail

source ./libraries/bash/env.sh

env.load build

OUTPUT_PATH="./image/output"
VM_NAME=ctk-installer
# The installer does not offer to erase the disk it booted from.
# This blank disk is the stand-in for the Surface internal drive.
TARGET_SIZE_MB=8192
boot_rebuilt=0
target_rebuilt=0

image_path="$(pwd)/${OUTPUT_PATH}/${IMG_NAME}-installer.img"
disk_path="$(pwd)/${OUTPUT_PATH}/${IMG_NAME}-installer.vdi"
target_path="$(pwd)/${OUTPUT_PATH}/${IMG_NAME}-installer-target.vdi"

if [[ ! -f "$image_path" ]]; then
  echo "Installer image does not exist: ${image_path}" >&2
  echo "Run ./bin/build-installer first." >&2
  exit 1
fi

if ! command -v VBoxManage >/dev/null; then
  echo "VBoxManage was not found. Install VirtualBox, then rerun this script." >&2
  exit 1
fi

ensure_vbox_module() {
  if [[ -e /dev/vboxdrv ]]; then
    return 0
  fi

  echo "The VirtualBox kernel module is not loaded. Building and loading it..."
  sudo /sbin/vboxconfig || true

  if [[ -e /dev/vboxdrv ]]; then
    return 0
  fi

  echo "VirtualBox did not load a kernel module for $(uname -r)." >&2
  if [[ -r /var/log/vbox-setup.log ]]; then
    grep -E '^ERROR:|vboxdrv.sh: failed' /var/log/vbox-setup.log >&2 || true
  fi
  echo "Installed VirtualBox is $(dpkg-query -W -f='${Version}' virtualbox-7.2). Kernel $(uname -r) needs VirtualBox 7.2.22." >&2
  echo "Upgrade, then rerun this script:" >&2
  echo "  wget https://download.virtualbox.org/virtualbox/7.2.22/virtualbox-7.2_7.2.22-175245~Ubuntu~noble_amd64.deb" >&2
  echo "  sudo apt install ./virtualbox-7.2_7.2.22-175245~Ubuntu~noble_amd64.deb" >&2
  exit 1
}

ensure_vbox_group() {
  if id -nG | grep -qw vboxusers; then
    return 0
  fi

  if ! id -nG "$USER" | grep -qw vboxusers; then
    echo "Adding ${USER} to the vboxusers group..."
    sudo usermod -aG vboxusers "$USER"
  fi

  local script
  script="$(command -v "$0" || true)"
  script="$(readlink -f "${script:-$0}")"
  echo "Restarting with the vboxusers group..."
  exec sg vboxusers -c "$(printf '%q ' "$script" "$@")"
}

ensure_vbox_module
ensure_vbox_group "$@"

vm_state() {
  VBoxManage showvminfo "$VM_NAME" --machinereadable \
    | sed -n 's/^VMState="\(.*\)"$/\1/p'
}

attached_port() {
  local port="$1"
  # VirtualBox names the attachment "SATA-<port>-<device>".
  VBoxManage showvminfo "$VM_NAME" --machinereadable \
    | sed -n "s/^\"SATA-${port}-0\"=\"\\(.*\\)\"$/\\1/p"
}

vm_exists() {
  VBoxManage list vms | grep -E "^\"${VM_NAME}\" " >/dev/null
}

vm_config_file() {
  VBoxManage showvminfo "$1" --machinereadable 2>/dev/null \
    | sed -n 's/^CfgFile="\(.*\)"$/\1/p'
}

forget_missing_vm() {
  local line name uuid config
  while IFS= read -r line; do
    [[ "$line" =~ ^\"([^\"]+)\"\ \{([0-9a-fA-F-]+)\} ]] || continue
    name="${BASH_REMATCH[1]}"
    uuid="${BASH_REMATCH[2]}"
    if [[ "$name" != "$VM_NAME" ]]; then
      continue
    fi
    config="$(vm_config_file "$uuid")"
    if [[ -z "$config" || ! -f "$config" ]]; then
      echo "VirtualBox machine ${VM_NAME} is registered, but its files are missing. Removing it..."
      VBoxManage unregistervm "$uuid"
    fi
  done < <(VBoxManage list vms 2>/dev/null)
}

ensure_vm() {
  forget_missing_vm
  if vm_exists; then
    return 0
  fi

  echo "Creating VirtualBox machine ${VM_NAME}..."
  VBoxManage createvm --name "$VM_NAME" --ostype Linux_64 --register
  VBoxManage modifyvm "$VM_NAME" \
    --memory 2048 \
    --cpus 2 \
    --firmware efi64 \
    --nic1 nat \
    --nic-type1 82540EM \
    --audio-enabled off \
    --boot1 disk \
    --graphicscontroller vmsvga \
    --vram 128 \
    --ioapic on \
    --rtc-use-utc on
  VBoxManage storagectl "$VM_NAME" \
    --name SATA \
    --add sata \
    --controller IntelAhci \
    --portcount 2 \
    --bootable on
}

require_powered_off() {
  if ! vm_exists; then
    return 0
  fi

  local state
  state="$(vm_state)"
  if [[ "$state" == "running" || "$state" == "paused" ]]; then
    echo "The installer image is newer than the VirtualBox disk, and ${VM_NAME} is ${state}." >&2
    echo "Power off the machine, then rerun this script." >&2
    exit 1
  fi
  if [[ "$state" == "saved" ]]; then
    VBoxManage discardstate "$VM_NAME"
  fi
}

detach_port() {
  local port="$1"
  local attached
  attached="$(attached_port "$port")"
  if [[ -n "$attached" && "$attached" != "none" ]]; then
    VBoxManage storageattach "$VM_NAME" \
      --storagectl SATA \
      --port "$port" \
      --device 0 \
      --type hdd \
      --medium none
  fi
}

close_medium() {
  local path="$1"
  local name="$2"
  if VBoxManage list hdds | grep -F "$name" >/dev/null; then
    VBoxManage closemedium disk "$path" || VBoxManage closemedium disk "$name"
  fi
}

ensure_disks() {
  local need_boot=0
  local need_target=0

  if [[ ! -f "$disk_path" || "$image_path" -nt "$disk_path" ]]; then
    need_boot=1
    need_target=1
  elif [[ ! -f "$target_path" ]]; then
    need_target=1
  fi

  if [[ "$need_boot" == 0 && "$need_target" == 0 ]]; then
    return 0
  fi

  require_powered_off
  if vm_exists; then
    VBoxManage storagectl "$VM_NAME" --name SATA --portcount 2
    if [[ "$need_boot" == 1 ]]; then
      detach_port 0
    fi
    if [[ "$need_target" == 1 ]]; then
      detach_port 1
    fi
  fi

  if [[ "$need_boot" == 1 ]]; then
    close_medium "$disk_path" "${IMG_NAME}-installer.vdi"
    rm -f "$disk_path"
    echo "Converting ${image_path} to a VirtualBox disk..."
    VBoxManage convertfromraw "$image_path" "$disk_path" --format VDI
    boot_rebuilt=1
  fi

  if [[ "$need_target" == 1 ]]; then
    close_medium "$target_path" "${IMG_NAME}-installer-target.vdi"
    rm -f "$target_path"
    echo "Creating an ${TARGET_SIZE_MB} MiB blank disk for the installer to erase..."
    VBoxManage createmedium disk \
      --filename "$target_path" \
      --size "$TARGET_SIZE_MB" \
      --format VDI
    target_rebuilt=1
  fi
}

attach_port() {
  local port="$1"
  local medium="$2"
  local rebuilt="$3"
  local attached
  attached="$(attached_port "$port")"
  if [[ "$rebuilt" != 1 && "$attached" == "$medium" ]]; then
    return 0
  fi

  if [[ -n "$attached" && "$attached" != "none" ]]; then
    VBoxManage storageattach "$VM_NAME" \
      --storagectl SATA \
      --port "$port" \
      --device 0 \
      --type hdd \
      --medium none
  fi

  VBoxManage storageattach "$VM_NAME" \
    --storagectl SATA \
    --port "$port" \
    --device 0 \
    --type hdd \
    --medium "$medium"
}

ensure_vm
ensure_disks

if [[ "$(vm_state)" == "running" ]]; then
  echo "${VM_NAME} is already running."
  exit 0
fi

VBoxManage storagectl "$VM_NAME" --name SATA --portcount 2
attach_port 0 "$disk_path" "$boot_rebuilt"
attach_port 1 "$target_path" "$target_rebuilt"

# A finished install leaves a bootable system on the second disk, and the
# firmware will start that system on the next power-on. Clear those saved
# boot entries so this script starts the installer image.
VBoxManage modifynvram "$VM_NAME" inituefivarstore

echo "Starting ${VM_NAME}..."
echo "The boot disk is the installer. Choose the other disk in the window and press Install."
VBoxManage startvm "$VM_NAME" --type gui
