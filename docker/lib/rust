#!/usr/bin/env bash

set -euo pipefail

source ./docker/lib/images.sh

rust.container() {
  local tty_args=(-i)
  if [[ -t 1 ]]; then
    tty_args+=(-t)
  fi

  docker run \
    --rm \
    "${tty_args[@]}" \
    --platform linux/amd64 \
    -e CARGO_HOME=/workdir/dist/cargo-home \
    -e CARGO_TARGET_DIR=dist/cargo \
    -u "$(id -u):$(id -g)" \
    -w /workdir \
    -v "$(pwd):/workdir" \
    "${RUST_IMAGE}" \
    "$@"
}

rust.cargo() {
  rust.container \
    cargo \
    "$@"
}

rust.rustc() {
  rust.container \
    rustc \
    "$@"
}
