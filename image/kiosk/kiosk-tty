#!/bin/sh
# Console session for the kiosk. Replaces getty on tty1.
exec </dev/tty1 >/dev/tty1 2>&1

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

modprobe i915 2>/dev/null || true
modprobe snd-hda-intel 2>/dev/null || true
modprobe hid-multitouch 2>/dev/null || true
modprobe atmel_mxt_ts 2>/dev/null || true

if [ ! -x /opt/ctk/kiosk-session ]; then
  echo "The kiosk session is missing." >&2
  exec /bin/sh
fi

# xinit treats a server name as extra arguments unless it starts with / or .
server=$(command -v Xorg || true)
if [ -z "$server" ]; then
  echo "Xorg is not installed." >&2
  exec /bin/sh
fi

exec xinit /opt/ctk/kiosk-session -- "$server" :0 vt1 -keeptty -nolisten tcp
